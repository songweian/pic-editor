{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pic-editor",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./build/web",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "pic.opengear.org",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
